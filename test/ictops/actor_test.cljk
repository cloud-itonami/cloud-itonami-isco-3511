(ns ictops.actor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [ictops.actor :as actor]
            [ictops.store :as store]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-client! st {:client-id "client-1" :name "Kobo Trade"})
    (store/register-system! st {:system-id "SYS-1" :client-id "client-1"
                                :name "payments-cluster"
                                :sla-response-minutes 30
                                :required-certifications #{"linux-admin"}})
    st))

(deftest commits-an-in-sla-fully-certified-response
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-incident-response :stake :low
                 :system-id "SYS-1" :response-time-minutes 20
                 :technician-certifications #{"linux-admin"}}
        result (actor/run-request! graph request {} "thread-1")]
    (is (= :done (:status result)))
    (is (some? (get-in result [:state :record])))
    (is (= 1 (count (store/records-of st "client-1"))))))

(deftest holds-an-over-sla-response
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-incident-response :stake :low
                 :system-id "SYS-1" :response-time-minutes 90
                 :technician-certifications #{"linux-admin"}}
        result (actor/run-request! graph request {} "thread-2")]
    (is (= :hold (:disposition (:state result))))
    (is (empty? (store/records-of st "client-1")))))

(deftest interrupts-then-approves-override-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:client-id "client-1" :op :approve-emergency-override :stake :high
                 :system-id "SYS-1"}
        interrupted (actor/run-request! graph request {} "thread-3")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "client-1")))
    (let [resumed (actor/approve! graph "thread-3")]
      (is (= :done (:status resumed)))
      (is (= 1 (count (store/records-of st "client-1")))))))
