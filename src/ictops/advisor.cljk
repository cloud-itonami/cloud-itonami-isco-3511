(ns ictops.advisor
  "ICTOperationsTechniciansAdvisor — proposes an incident-response
  operation (approve an incident response, approve an emergency
  override) for a registered organization. Swappable mock/llm; the
  advisor ONLY proposes — `ictops.governor` checks the SLA arithmetic
  and certification coverage independently. Modeled on
  cloud-itonami-isco-4311's advisor.

  A proposal: {:op :approve-incident-response|:approve-emergency-override
               :effect :propose :system-id str
               :response-time-minutes number
               :technician-certifications #{str} :stake kw
               :confidence n :rationale str}"
  (:require #?(:clj [kotoba.lang.edn :as edn]
               :cljs [cljs.reader :as edn])))

(defprotocol Advisor
  (-advise [advisor store request] "request -> proposal map"))

(defn- infer [_store {:keys [op stake system-id response-time-minutes
                             technician-certifications] :as request}]
  {:op op
   :effect :propose
   :system-id system-id
   :response-time-minutes response-time-minutes
   :technician-certifications technician-certifications
   :stake (or stake :low)
   :confidence (case (or stake :low) :high 0.7 :medium 0.85 :low 0.95)
   :rationale (str "proposed " (name op) " for client " (:client-id request))})

(defn mock-advisor []
  (reify Advisor
    (-advise [_ store request] (infer store request))))

(def ^:private system-prompt
  "You are an ICT operations advisor. Given a request, propose an
   :op, the :system-id, :response-time-minutes and
   :technician-certifications, an honest :confidence and a :stake.
   Never call an over-SLA response or an under-certified technician
   conforming — the governor checks both against the registered
   system record.")

(defn- parse-proposal [content]
  (try
    (let [p (edn/read-string content)]
      (if (map? p)
        (assoc p :effect :propose)
        {:op :unknown :effect :propose :confidence 0.0 :stake :high
         :rationale "unparseable LLM response"}))
    (catch #?(:clj Exception :cljs js/Error) _
      {:op :unknown :effect :propose :confidence 0.0 :stake :high
       :rationale "LLM response parse failure"})))

(defn llm-advisor
  [chat-model model-generate-fn gen-opts]
  (reify Advisor
    (-advise [_ _store request]
      (let [msgs [{:role :system :content system-prompt}
                  {:role :user :content (str "operation request: " (pr-str request))}]
            resp (model-generate-fn chat-model msgs gen-opts)]
        (parse-proposal (:content resp))))))
